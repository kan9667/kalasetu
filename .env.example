# ============================================================
# Kalasetu — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# This file holds variable NAMES only — never real keys.
# ============================================================


# ── Voice Pipeline (Bhashini ASR + translation) ─────────────
# Free registration: https://bhashini.gov.in/ulca/user/register
# Both values are in "My Profile" after you log in.
BHASHINI_USER_ID=
BHASHINI_API_KEY=


# ── Backend + Pricing Pipeline (Google Gemini) ──────────────
# Used for catalog listing generation and price embeddings.
GEMINI_API_KEY=


# ── Backend (optional — sensible defaults exist) ────────────
# DEBUG=false
# HOST=0.0.0.0
# PORT=8000
