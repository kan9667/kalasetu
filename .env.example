# ============================================================
# Kalasetu — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# This file holds variable NAMES only — never real keys.
# ============================================================


# ── Voice Pipeline (Whisper transcription) ──────────────────
# Any OpenAI-compatible audio transcription endpoint works.
# Set WHISPER_BASE_URL to the host you use, and its matching key.
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.groq.com/openai/v1
WHISPER_MODEL=whisper-large-v3

GROQ_API_KEY=


# ── Backend + Pricing Pipeline (Google Gemini) ──────────────
# Used for catalog listing generation and price embeddings.
GEMINI_API_KEY=


# ── Backend (optional — sensible defaults exist) ────────────
# DEBUG=false
# HOST=0.0.0.0
# PORT=8000

# ── Authentication & Security ───────────────────────────────
# In production, JWT_SECRET_KEY MUST be set to a high-entropy secret (min 32 characters).
JWT_SECRET_KEY=
ENVIRONMENT=development
ALLOW_DEMO_OTP=true

# ── SMS Provider Configuration ──────────────────────────────
# Supported providers: console, mock, http, 2factor
# In production, SMS_PROVIDER must be 'http' or '2factor' with valid credentials.
# For 2Factor: SMS_PROVIDER=2factor, SMS_API_KEY=<your_api_key>, SMS_TEMPLATE_NAME=<optional_dlt_template>
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_NAME=
ENABLE_REAL_SMS=false
DAILY_SMS_CAP=20
DAILY_PHONE_SMS_CAP=3

# ── CORS Configuration ──────────────────────────────────────
# Comma-separated list of allowed origins. Wildcard ('*') is forbidden in production with credentials.
CORS_ORIGINS=https://kalasetu.in,https://app.kalasetu.in
