# ============================================================
# Kalasetu — Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is gitignored and must never be committed.
# This file holds variable NAMES only — never real keys.
# ============================================================


# ── Voice Pipeline (Whisper transcription) ──────────────────
# Any OpenAI-compatible audio transcription endpoint works.
# Set WHISPER_BASE_URL to the host you use, and its matching key.
WHISPER_API_KEY=
WHISPER_BASE_URL=
WHISPER_MODEL=whisper-large-v3


# ── Backend + Pricing Pipeline (Google Gemini) ──────────────
# Used for catalog listing generation and price embeddings.
GEMINI_API_KEY=


# ── Backend (optional — sensible defaults exist) ────────────
# DEBUG=false
# HOST=0.0.0.0
# PORT=8000
